<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes Kodi Reader for this PC into a fixed per-user folder, so "Start with Windows"
  keeps pointing to the same exe after every update.
  Framework-dependent: needs the .NET 10 Desktop Runtime (already installed on this PC).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(LOCALAPPDATA)\Programs\KodiReader\</PublishDir>
  </PropertyGroup>
</Project>
